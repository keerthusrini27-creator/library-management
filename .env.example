# Copy this to .env and fill in your Supabase values
# Never commit .env to git

FLASK_SECRET_KEY=change-me-to-a-random-string
FLASK_DEBUG=0

# Option A (recommended, same as Render): one connection string from Supabase
# DATABASE_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-xxx.pooler.supabase.com:5432/postgres

# Option B: separate settings (used only when DATABASE_URL is not set)
PG_HOST=db.xxxxxxxxxxxx.supabase.co
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your-supabase-db-password
PG_DATABASE=postgres
PG_SSLMODE=require
